{
  "sandbox": {
    "filesystem": {
      "allowRead": [
        "./"
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/check-skills-hook.sh\"",
            "timeout": 15,
            "statusMessage": "SKILL.mdのfrontmatterを検証中..."
          }
        ]
      }
    ]
  }
}
